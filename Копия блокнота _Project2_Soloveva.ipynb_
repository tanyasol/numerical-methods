{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[{"file_id":"1zKJBIT-lEnUgGy_rjcYKK6yeUtdimD5b","timestamp":1791928417525}],"authorship_tag":"ABX9TyO/e9oCdTTSazDxgNkVGSTh"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":499},"id":"g2k6ljRTltlW","executionInfo":{"status":"ok","timestamp":1775860167255,"user_tz":-180,"elapsed":303,"user":{"displayName":"Соловьева Татьяна Константиновна","userId":"08136468604264160266"}},"outputId":"25339c35-1773-42e1-fe96-a8490008f33b"},"outputs":[{"output_type":"stream","name":"stdout","text":["Значения а: 0.9059411868843151\n","Значения и: 0.6937620074494534\n","Количество итераций : 2\n"]},{"output_type":"execute_result","data":{"text/plain":["<matplotlib.legend.Legend at 0x7e1838524da0>"]},"metadata":{},"execution_count":10},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import numpy as np\n","import matplotlib.pyplot as plt\n","\n","n = 2\n","xi = np.linspace(0, 1, n + 2)\n","h = 1/(n + 1)\n","A = []\n","y0 = 1\n","yn1 = 0.5\n","\n","def fi(x):\n","  return 2*(x**2 - 1) / (1 + x**2)**3\n","\n","def F(a, b, x):\n","   ans = np.array([b - 2 * a + 1 - (b - 1)**2 / (4 * a) - h**2 * fi(x[1]),\n","        0.5 - 2 * b + a - (0.5 - a)**2 / (4 * b) - h**2 * fi(x[2])])\n","   return ans\n","\n","\n","def J(a, b):\n","    J11 = -2 + (b - 1)**2 / (4 * a**2)\n","    J12 = 1 - (b - 1) / (2 * a)\n","    J21 = 1 + (0.5 - a) / (2 * b)\n","    J22 = -2 + (0.5 - a)**2 / (4 * b**2)\n","    return np.array([[J11, J12], [J21, J22]])\n","\n","\n","def Newton(x0 ,F, J, eps, x):\n","  yn = []\n","  yn.append(x0.copy())\n","  a = yn[-1][0]\n","  b = yn[-1][1]\n","  J_inv = np.linalg.inv(J(a, b))\n","  F_val = F(a, b, x)\n","  s = J_inv @ F_val\n","\n","  yn.append(yn[-1] - s)\n","  i = 0\n","  while np.linalg.norm(yn[-1] - yn[-2]) > eps and i < 500:\n","      i +=1\n","      a = yn[-1][0]\n","      b = yn[-1][1]\n","\n","      J_inv = np.linalg.inv(J(a, b))\n","      F_val = F(a, b, x)\n","      s = J_inv @ F_val\n","\n","      yn.append(yn[-1] - s)\n","\n","  return yn[-1], i\n","\n","\n","x0 = np.array([1, 1])\n","res , iter= Newton(x0, F, J, 1e-4, xi)\n","print(\"Значения а:\", res[0])\n","print(\"Значения и:\", res[1])\n","print(\"Количество итераций :\", iter)\n","\n","\n","def f_analytical(x):\n","  return 1 / (1 + x**2)\n","\n","points = np.linspace(0, 1, 100)\n","plt.plot(points, f_analytical(points), label = \"f_analytical\", color = \"r\")\n","yi = [y0, res[0], res[1], yn1]\n","plt.plot(xi, yi, label = \"f_Newton_method\", color = \"pink\")\n","plt.scatter(xi, yi, color = \"r\")\n","plt.grid()\n","plt.legend()"]}]}